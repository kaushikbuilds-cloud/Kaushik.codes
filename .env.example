# ─────────────────────────────────────────────────────────────
# Kaushik Codes — Environment Variables
# Copy this file to `.env` and fill in your Supabase project values.
# Only the anon/public key is used on the client. NEVER put the
# Supabase Service Role key here — it must stay server-side only.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The public site URL (used for canonical URLs, sitemap & share links)
VITE_SITE_URL=https://kaushik.codes
